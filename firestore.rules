rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Mosque settings document (synced across all devices, accounts & links)
    match /settings/{settingId} {
      allow read, write: if true;
    }
    
    // Realtime murattal progress
    match /murattal_progress/{progressId} {
      allow read, write: if true;
    }

    // Cross-device shared photo, video & announcement slides
    match /cloud_slides/{slideId} {
      allow read, write: if true;
    }

    // Chunked media segments for cross-device videos & large photos
    match /cloud_slide_chunks/{chunkId} {
      allow read, write: if true;
    }

    // Cross-device shared standalone media assets (himbauan image, etc.)
    match /cloud_media/{mediaId} {
      allow read, write: if true;
    }

    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
